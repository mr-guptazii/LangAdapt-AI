# Copy to .env and fill in real values for production. The app boots and runs
# fully with mock providers using only the defaults below (see AI_SYSTEM.md).

ENV=development
DEBUG=true

# --- Database (docker-compose default; adjust host if running natively) ---
DATABASE_URL=postgresql+asyncpg://lingoadapt:lingoadapt@localhost:5432/lingoadapt
DATABASE_URL_SYNC=postgresql+psycopg2://lingoadapt:lingoadapt@localhost:5432/lingoadapt

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-value
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- LLM provider: mock | anthropic | openai ---
# LLM_PROVIDER=openai routes through OpenAICompatibleProvider, which works
# with ANY OpenAI-Chat-Completions-compatible backend — set OPENAI_BASE_URL to
# pick which one. Leave OPENAI_BASE_URL empty for real OpenAI. Examples:
#   Groq:        OPENAI_BASE_URL=https://api.groq.com/openai/v1
#                OPENAI_API_KEY=<your Groq API key, from console.groq.com>
#                OPENAI_MODEL_FAST=llama-3.1-8b-instant
#                OPENAI_MODEL_STRONG=llama-3.3-70b-versatile
#                (RECOMMENDED: free tier is a genuine recurring daily quota —
#                thousands of requests/day, not a one-time credit pool — and
#                both models above verified working with forced tool-calling.
#                Verify current model names against `GET {base_url}/models`
#                with your own key; Groq's lineup changes.)
#   NVIDIA NIM:  OPENAI_BASE_URL=https://integrate.api.nvidia.com/v1
#                OPENAI_API_KEY=<your NVIDIA API key>
#                OPENAI_MODEL_FAST=meta/llama-3.1-8b-instruct
#                OPENAI_MODEL_STRONG=meta/llama-3.3-70b-instruct
#                (free tier is a ONE-TIME pool of trial credits, not a
#                recurring quota — it permanently runs out.)
#   Gemini:      OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#                OPENAI_API_KEY=<your Gemini API key>
#                OPENAI_MODEL_FAST=gemini-3.6-flash
#                OPENAI_MODEL_STRONG=gemini-3.6-flash
#                (free tier is a hard 20 requests/day for gemini-3.6-flash as
#                of this writing — pro-tier models get ZERO free quota. Fine
#                for a quick local check, too small for a live deployed app.
#                Verify current model names against `GET {base_url}/models`
#                with your own key before assuming any model name in this file
#                still exists — Gemini's lineup moves fast. See AI_SYSTEM.md
#                for the full story, including a real MALFORMED_FUNCTION_CALL
#                failure this surfaced on a "thinking" model with too small a
#                token budget.)
# Pick a model that's documented as supporting function/tool calling — that's
# what structured output relies on (see AI_SYSTEM.md).
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_STRONG=claude-sonnet-5
ANTHROPIC_MODEL_FAST=claude-haiku-4-5-20251001
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL_STRONG=gpt-4o
OPENAI_MODEL_FAST=gpt-4o-mini

# --- Voice: mock | openai_whisper (STT) / openai_tts (TTS) ---
# openai_whisper/openai_tts hit whatever OPENAI_BASE_URL points at above (same
# pattern as the LLM provider), so STT_MODEL/TTS_MODEL must be a real model
# name on THAT backend, not necessarily OpenAI's. On Groq: STT_MODEL=
# whisper-large-v3-turbo (verified working — real Whisper transcription, not
# OpenAI's "whisper-1" which doesn't exist on Groq). TTS_PROVIDER=openai_tts
# has not been verified against Groq; leave it mock unless you confirm a
# working TTS model name via `GET {base_url}/models` first.
STT_PROVIDER=mock
STT_MODEL=whisper-1
TTS_PROVIDER=mock
TTS_MODEL=tts-1
PRONUNCIATION_PROVIDER=mock
STORE_RAW_AUDIO=false

# --- Embeddings (semantic memory): mock | anthropic ---
EMBEDDING_PROVIDER=mock
EMBEDDING_DIM=384

# --- Observability ---
SENTRY_DSN=
LOG_LEVEL=INFO

# --- CORS / frontend ---
CORS_ORIGINS=["http://localhost:3000"]
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Self-hosted VM production stack only (infrastructure/vm/docker-compose.prod.yml) ---
# Not used by local dev or the Render+Vercel path. Required there — see
# docs/DEPLOYMENT.md's "Self-hosted VM" section.
POSTGRES_PASSWORD=
REDIS_PASSWORD=
DOMAIN=
